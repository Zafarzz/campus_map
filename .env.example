# Front end <-> backend integration. Copy to `.env.local` (git-ignored) to override.
#
# The map calls the FastAPI backend through the Vite dev proxy (same origin, no CORS/mixed content).
# If the backend is unreachable the app silently falls back to the static demo data.

# Where the dev server proxies /api, /healthz, /readyz and /ws. Default: http://127.0.0.1:8000
# Remote Oracle server: http://92.5.52.80   (needs the OCI ingress rule for port 80)
# Or SSH tunnel:        ssh -i <key> -N -L 8000:127.0.0.1:8000 ubuntu@92.5.52.80  (keep default)
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Set to false to force static demo data and hide the backend status panel.
# VITE_USE_BACKEND=false

# Production builds only: absolute API origin (leave unset in dev).
# VITE_API_BASE_URL=https://api.example.com

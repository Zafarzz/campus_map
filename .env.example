# Front end <-> backend integration. Copy to `.env.local` (git-ignored) to override.
#
# Full-stack Docker (one command for PostgreSQL + FastAPI + Vite 3D Map):
#   docker compose up --build
#   (Inside Docker Compose, VITE_BACKEND_PROXY_TARGET is set to http://api:8000 automatically.)
#
# Host-side Vite (`npm run dev` outside Docker):
#   The map calls the FastAPI backend through the Vite dev proxy (same origin, no CORS/mixed content).
#   If the backend is unreachable the app silently falls back to the static demo data.

# Where the host Vite dev server proxies /api, /healthz, /readyz and /ws. Default: http://127.0.0.1:8000
# Live deployment:      https://unicampus.zafik.dev
# Or SSH tunnel:        ssh -i <key> -N -L 8000:127.0.0.1:8000 ubuntu@92.5.52.80  (keep default)
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Set to false to force static demo data and hide the backend status panel.
# VITE_USE_BACKEND=false

# Optional: absolute API origin (leave unset when served behind a same-origin proxy).
# VITE_API_BASE_URL=https://api.example.com

# Campus Digital Twin backend — example configuration.
# Copy to backend/.env and adjust. NEVER commit backend/.env.
#
# Settings without a default are REQUIRED: the app refuses to start without them
# rather than guessing. See app/core/config.py.

# --------------------------------------------------------------------- identity

APP_ENV=development                  # development | test | staging | production
APP_DEBUG=true
APP_NAME="Campus Digital Twin"

# --------------------------------------------------------------------- time
# REQUIRED, no default (MASTER_PROMPT.md section 24 Q1). IANA zone of the campus.
# Confirmed by the repository owner on 2026-10-17: Asia/Tashkent (UTC+5, no DST).
# The code must not assume "no DST" — DST transitions are tested regardless.
CAMPUS_TZ=Asia/Tashkent

# --------------------------------------------------------------------- database
# PostgreSQL only, 16+ (we run 18). No SQLite, not even for tests.
# Async driver URL used by the application and by Alembic.
DATABASE_URL=postgresql+asyncpg://campus_app:change-me-app@localhost:5433/campus

# Migration/owner role. Separate from the application role (least privilege).
DATABASE_MIGRATION_URL=postgresql+asyncpg://campus_owner:change-me-owner@localhost:5433/campus

# Tests create and drop their own database derived from this URL by appending
# "_test" to the database name. They never touch development data.
DATABASE_TEST_URL=postgresql+asyncpg://campus_owner:change-me-owner@localhost:5433/campus

DATABASE_SCHEMA=campus
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# Credentials handed to the local docker-compose Postgres container.
POSTGRES_OWNER_PASSWORD=change-me-owner
POSTGRES_APP_PASSWORD=change-me-app
POSTGRES_PORT=5433                   # host port; container always listens on 5432

# --------------------------------------------------------------------- api

API_PREFIX=/api/v1
# Comma-separated exact origins allowed by CORS. The Vite dev server runs on
# HTTPS with host:true, so include the hostname you actually load the page from.
CORS_ALLOW_ORIGINS=https://localhost:5173,https://127.0.0.1:5173

# --------------------------------------------------------------------- auth
# REQUIRED, no default. Generate one: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=1800

# Local username/password accounts are a DEVELOPMENT convenience only and are
# rejected outright when APP_ENV is staging or production.
AUTH_ALLOW_LOCAL_ACCOUNTS=true

# OIDC (Phase 8). Leave blank until a provider exists.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_EMAIL_DOMAINS=ajou.uz

# --------------------------------------------------------------------- behaviour

# "Starts soon" window. The front end uses 60 (src/config/mapConfig.ts); the
# brief's clean-API default is 15. Compat responses always use COMPAT_*.
STARTS_SOON_MINUTES=15
COMPAT_UPCOMING_WINDOW_MINUTES=60

# Smallest aggregate that may be published (privacy, brief section 9).
SMALL_CELL_MIN_COUNT=10

# Deterministic demo data.
DEMO_RANDOM_SEED=20261017

# --------------------------------------------------------------------- sources
# Public EduPage timetable for Ajou University in Tashkent. Read-only, fetched
# on demand by scripts/fetch_edupage_timetable.py; snapshots are never committed.
EDUPAGE_BASE_URL=https://aut.edupage.org
# blank = use EduPage's current default
EDUPAGE_TIMETABLE_NUMBER=

# Path to the front-end source, read-only, used by the campus extractor.
FRONTEND_SRC_DIR=../src

# --------------------------------------------------------------------- optional

# blank = in-process fallback for local dev
REDIS_URL=
LOG_LEVEL=INFO
LOG_JSON=false                       # true in production, human-readable locally
